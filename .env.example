# PulseDesk AI - Environment Template Example
# Copy this file to .env for local development

# Server Configuration
PORT=8000
NODE_ENV=production
API_BASE_URL=https://pulsedesk-backend.onrender.com

# AI Engine & LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector Database Credentials
VECTOR_DB_URL=your_vector_db_url_here
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
